{
  "name": "trivoxa-group",
  "version": "0.1.0",
  "private": true,
  "description": "Trivoxa Group — international trade and business group. Rebuild of trivoxagroup.com.",
  "scripts": {
    "predev": "tsx scripts/sync-fonts.ts && tsx scripts/build-brand.ts",
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "prebuild": "tsx scripts/sync-fonts.ts && tsx scripts/build-brand.ts",
    "build": "tsx scripts/check-taxonomy.ts && next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:taxonomy": "tsx scripts/check-taxonomy.ts",
    "check:brand": "tsx scripts/check-brand-assets.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "brand": "tsx scripts/build-brand.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.2.5",
    "@fontsource/instrument-serif": "^5.2.5",
    "@fontsource/inter": "^5.3.0",
    "@hookform/resolvers": "^5.2.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "@vercel/analytics": "^1.6.1",
    "animejs": "^4.5.0",
    "clsx": "^2.1.1",
    "cobe": "^0.1.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "next": "^16.3.4",
    "next-intl": "^4.14.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.87.0",
    "resend": "^4.8.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.18.0",
    "@types/potrace": "^2.1.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.25",
    "jsdom": "^25.0.1",
    "potrace": "^2.1.8",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sharp": "^0.35.4",
    "svgo": "^3.3.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
